rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Administração (avisos para todos os utilizadores da app).
    function isAdmin() {
      return isLoggedIn() && request.auth.token.email == 'conectaja.ao@gmail.com';
    }

    function isParticipant(convData) {
      return request.auth.uid in convData.participants;
    }

    // ── Utilizadores ──
    match /users/{uid} {
      allow read:  if isLoggedIn();
      allow write: if isOwner(uid);
    }

    // ── Prestadores (e clientes — a app guarda ambos aqui) ──
    match /providers/{uid} {
      // Leitura pública: listas, mapa, perfis e contagem de indicações
      allow read: if true;

      // Criação: só o próprio, e sem campos privilegiados
      // (plan/planUntil/verificationLevel só via Console;
      //  verified/rating/reviews têm de nascer com os valores neutros)
      allow create: if isLoggedIn() && isOwner(uid)
        && !request.resource.data.keys().hasAny(['plan', 'planUntil', 'verificationLevel'])
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('reviews', 0) == 0;

      // Atualização:
      //  a) o próprio edita o perfil, MAS não pode tocar nos campos
      //     privilegiados (anti auto-premium / auto-verificado / auto-rating)
      //  b) qualquer utilizador autenticado pode atualizar APENAS
      //     rating+reviews (recálculo automático do sistema de avaliações)
      allow update: if isLoggedIn() && (
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verified', 'verificationLevel', 'plan', 'planUntil', 'rating', 'reviews']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'reviews']))
        ||
        // c) a administração activa ou retira o Destaque (só plan/planUntil), depois de confirmar o pagamento
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['plan', 'planUntil']))
      );

      // Eliminação de conta: só o próprio
      allow delete: if isLoggedIn() && isOwner(uid);

      // Pró-formas do prestador: só ele as vê e emite.
      match /proformas/{pfId} {
        allow read: if isLoggedIn() && isOwner(uid);
        allow create: if isLoggedIn() && isOwner(uid) && proformaValida(request.resource.data);
        allow delete: if isLoggedIn() && isOwner(uid);
      }
      match /proformaSeq/{seqId} {
        allow read: if isLoggedIn() && isOwner(uid);
        allow write: if isLoggedIn() && isOwner(uid) && seqId == 'atual' && contadorProforma();
      }
    }

    // ── Pedidos de serviço (a app usa a coleção "orders") ──
    match /orders/{orderId} {
      // Só o cliente e o prestador envolvidos veem o pedido
      allow read: if isLoggedIn() &&
        (isOwner(resource.data.clientId) || isOwner(resource.data.providerId));

      // Criação: só o próprio cliente, sempre pendente e sem pagamento
      // (paymentStatus held/released só via Console — escrow manual)
      allow create: if isLoggedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('paymentStatus', 'none') == 'none';

      // Atualização: só o prestador do pedido, apenas nos campos do fluxo
      // (aceitar com orçamento, iniciar, concluir, recusar)
      allow update: if isLoggedIn()
        && isOwner(resource.data.providerId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'quote', 'quoteNote', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'in_progress', 'completed', 'cancelled'];
    }

    // ── Pedidos de verificação de identidade (BI) ──
    match /verificationRequests/{uid} {
      allow read: if isLoggedIn() && isOwner(uid);
      // O utilizador só consegue submeter como "pending" —
      // aprovar/rejeitar é exclusivo do Console (admin)
      allow create, update: if isLoggedIn() && isOwner(uid)
        && request.resource.data.status == 'pending';
    }

    // ── Códigos de notificação da app (Expo Push) ──
    match /pushTokens/{uid} {
      // Um de cada vez: quem faz uma acção avisa a outra pessoa (pedido, mensagem, proposta)
      allow get: if isLoggedIn();
      // Listar todos (enviar um aviso a toda a gente) só a administração
      allow list: if isAdmin();
      // Cada um só mexe nos seus
      allow write: if isLoggedIn() && isOwner(uid);
    }

    // ── Estatísticas globais (contadores da homepage) ──
    match /stats/{docId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    // ── Anúncios da página inicial: o público vê os activos, só a administração escreve ──
    match /anuncios/{anuncioId} {
      function anuncioValido(d) {
        return d.titulo is string && d.titulo.size() >= 2 && d.titulo.size() <= 60
          && d.texto is string && d.texto.size() <= 140
          && urlImagem(d.imagemUrl)
          && d.destino in ['nenhum', 'prestador', 'negocio', 'link']
          && d.alvo is string && d.alvo.size() <= 300
          && (d.destino != 'link' || d.alvo.matches('^https://[^ <>"]+$'))
          && d.estado in ['ativo', 'pausado']
          && d.ordem is number
          && d.ate is number;
      }
      allow read: if resource.data.estado == 'ativo' || isAdmin();
      allow create, update: if isAdmin() && anuncioValido(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── Conversas ──
    match /conversations/{convId} {

      // Leitura: participante OU documento não existe ainda (para .get() antes de criar)
      allow read: if isLoggedIn() && (
        resource == null ||
        isParticipant(resource.data)
      );

      // Criação: utilizador tem de ser participante nos dados que está a escrever
      allow create: if isLoggedIn() &&
        isParticipant(request.resource.data);

      // Actualização: só participantes existentes
      allow update: if isLoggedIn() &&
        isParticipant(resource.data);

      // Mensagens
      match /messages/{msgId} {
        allow read: if isLoggedIn() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(convId)).data);

        allow create: if isLoggedIn() &&
          isParticipant(get(/databases/$(database)/documents/conversations/$(convId)).data) &&
          request.resource.data.senderId == request.auth.uid;
      }
    }

    // ── Bisno — Publicações ──
    match /posts/{postId} {
      // Qualquer um pode ler (feed público)
      allow read: if true;

      // Só utilizadores autenticados podem criar
      allow create: if isLoggedIn() &&
        request.resource.data.uid == request.auth.uid;

      // Só o autor pode apagar ou editar o conteúdo
      allow delete: if isLoggedIn() && isOwner(resource.data.uid);
      allow update: if isLoggedIn() && (
        // Autor pode editar tudo
        isOwner(resource.data.uid) ||
        // Qualquer utilizador pode dar like / marcar resolved
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedBy', 'likeCount', 'resolved']))
      );

      // Comentários dentro de cada post
      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isLoggedIn() &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isLoggedIn() && isOwner(resource.data.uid);
        allow update: if isLoggedIn() && isOwner(resource.data.uid);
      }
    }

    // ── Bisno — Denúncias ──
    match /reports/{reportId} {
      allow create: if isLoggedIn();
      allow read, update, delete: if false; // só admins
    }

    // ── Notificações pendentes ──
    match /pendingNotifications/{docId} {
      allow create: if isLoggedIn();
      allow read, delete: if false;
    }

    // ── Avaliações ──
    match /reviews/{reviewId} {
      allow read: if true;
      // Criação: o autor é o próprio (o código grava clientId, não authorId)
      allow create: if isLoggedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // Edição: só o autor, apenas rating/texto, com nota válida
      allow update: if isLoggedIn() && isOwner(resource.data.clientId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'text', 'updatedAt'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if isLoggedIn() && isOwner(resource.data.clientId);
    }

    // ── Negócios (lojas com catálogo) ──
    function podeGerir(n) {
      return isLoggedIn() && (n.ownerUid == request.auth.uid || request.auth.uid in n.get('equipa', {}));
    }
    // Dono ou gerente. A caixa só trata de pedidos e de abrir e fechar a loja.
    function podeEditar(n) {
      return isLoggedIn() && (n.ownerUid == request.auth.uid || n.get('equipa', {}).get(request.auth.uid, '') == 'gerente');
    }
    // Empresa: 10 dígitos. Empresário em nome individual: número do BI.
    function nifValido(nif) {
      return nif is string && nif.matches('^([0-9]{10}|[0-9]{9}[A-Z]{2}[0-9]{3})$');
    }
    // Vazio, ou um https: o site mete este valor num <img>.
    // Pró-forma: documento fechado (não se edita depois de emitida). Só campos conhecidos e tamanhos limitados.
    function proformaValida(d) {
      return d.keys().hasOnly(['emitente', 'cliente', 'linhas', 'desconto', 'taxaEntrega', 'ivaPct', 'validadeDias', 'pagamento', 'notas', 'pedidoId', 'seq', 'numero', 'ano', 'criadoEm', 'criadoPor'])
        && d.cliente is map && d.cliente.nome is string && d.cliente.nome.size() >= 2 && d.cliente.nome.size() <= 120
        && d.emitente is map && d.emitente.nome is string && d.emitente.nome.size() <= 120
        && d.linhas is list && d.linhas.size() >= 1 && d.linhas.size() <= 60
        && d.seq is int && d.seq >= 1 && d.numero is string && d.numero.size() <= 20
        && d.ivaPct is number && d.ivaPct >= 0 && d.ivaPct <= 30
        && d.pagamento is string && d.pagamento.size() <= 300 && d.notas is string && d.notas.size() <= 500
        && d.criadoPor == request.auth.uid && d.criadoEm == request.time;
    }
    function contadorProforma() {
      return request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
        && request.resource.data.n == (resource == null ? 1 : resource.data.n + 1);
    }
    function urlImagem(v) {
      return v is string && v.size() <= 300 && (v == '' || v.matches('^https://[^ <>"]+$'));
    }
    function negocioValido(d) {
      return d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 80
        && d.categoria in ['restaurante', 'padaria', 'supermercado', 'farmacia', 'boutique', 'oficina', 'outro']
        && d.get('tipoOutro', '') is string && d.get('tipoOutro', '').size() <= 40
        && (d.categoria != 'outro' || d.get('tipoOutro', '').size() >= 2)
        && d.descricao is string && d.descricao.size() <= 600
        && d.telefone is string && d.telefone.matches('^[+]2449[0-9]{8}$')
        && d.province is string && d.province.size() > 0
        && d.municipality is string && d.municipality.size() > 0
        && d.neighborhood is string && d.neighborhood.size() <= 80
        && d.horario is map
        && d.entrega is bool
        && d.tempoEntrega is string && d.tempoEntrega.size() <= 30
        && d.get('taxaEntrega', 0) is number && d.get('taxaEntrega', 0) >= 0
        && d.get('mesas', false) is bool
        && d.get('lojaFechada', false) is bool
        && d.get('filaAberta', false) is bool
        && d.get('dadosPagamento', '') is string && d.get('dadosPagamento', '').size() <= 160
        && d.get('fornada', {}) is map
        && d.get('sobras', []) is list && d.get('sobras', []).size() <= 5
        && d.get('fidelidade', {}) is map
        && d.get('equipa', {}) is map
        && d.get('membros', []) is list && d.get('membros', []).size() <= 20
        && d.get('filiais', []) is list && d.get('filiais', []).size() <= 10
        && urlImagem(d.logoUrl) && urlImagem(d.capaUrl);
    }
    function produtoValido(d) {
      return d.nome is string && d.nome.size() >= 1 && d.nome.size() <= 100
        && d.descricao is string && d.descricao.size() <= 300
        && d.preco is number && d.preco >= 0
        && (d.stock == null || (d.stock is int && d.stock >= 0))
        && d.ativo is bool
        && d.ordem is number
        && urlImagem(d.fotoUrl);
    }

    // Pedido novo: tudo o que dá para conferir aqui. O preço de cada item não dá (sem ciclos nas regras):
    // o negócio vê os itens e o total antes de aceitar.
    function pedidoValido(database, d, n, negocioId) {
      return d.clienteUid == request.auth.uid
        && n.status == 'aprovado'
        && n.get('lojaFechada', false) == false
        && d.negocioId == negocioId
        && d.estado == 'novo'
        && d.pago == false
        && d.clienteNome is string && d.clienteNome.size() <= 100
        && d.clienteTelefone is string && d.clienteTelefone.size() <= 20
        && d.modo in ['levantar', 'entrega', 'mesa']
        && (d.modo != 'entrega' || (n.entrega == true && d.morada is string && d.morada.size() >= 3 && d.morada.size() <= 160))
        && (d.modo != 'mesa' || (n.get('mesas', false) == true && d.mesa is string && d.mesa.size() >= 1 && d.mesa.size() <= 10))
        && d.hora is string && d.hora.size() <= 5
        && d.get('filial', '') is string && d.get('filial', '').size() <= 60
        && d.pagamento in ['referencia', 'dinheiro']
        && (d.pagamento != 'referencia' || n.get('dadosPagamento', '') != '')
        && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 50
        && d.subtotal is number && d.subtotal > 0
        && d.taxa == (d.modo == 'entrega' ? n.get('taxaEntrega', 0) : 0)
        && d.total == d.subtotal + d.taxa - d.desconto
        && (d.desconto == 0 || (
          d.desconto == n.fidelidade.desconto
          && d.subtotal >= d.desconto
          && get(/databases/$(database)/documents/negocios/$(negocioId)/cartoes/$(request.auth.uid)).data.carimbos >= n.fidelidade.meta
        ));
    }
    function transicaoPedido(de, para) {
      return para == de
        || (de == 'novo' && para in ['preparo', 'cancelado'])
        || (de == 'preparo' && para in ['pronto', 'cancelado'])
        || (de == 'pronto' && para in ['entregue', 'cancelado']);
    }

    // Os pedidos a lojas de um cliente, em todos os negócios (separador Lojas em Pedidos).
    match /{caminho=**}/pedidos/{pedidoId} {
      allow list: if isLoggedIn() && resource.data.clienteUid == request.auth.uid;
    }
    match /{caminho=**}/reservas/{reservaId} {
      allow list: if isLoggedIn() && resource.data.clienteUid == request.auth.uid;
    }
    // Só para apagar as senhas ao eliminar a conta.
    match /{caminho=**}/fila/{senhaId} {
      allow list: if isLoggedIn() && resource.data.clienteUid == request.auth.uid;
    }

    match /negocios/{negocioId} {
      function negocio() {
        return get(/databases/$(database)/documents/negocios/$(negocioId)).data;
      }
      function negocioDepois() {
        return getAfter(/databases/$(database)/documents/negocios/$(negocioId)).data;
      }
      // A média só muda junto com a avaliação de quem escreve: uma nova, editada ou apagada.
      function contagemAvaliacao() {
        let aval = /databases/$(database)/documents/negocios/$(negocioId)/avaliacoes/$(request.auth.uid);
        let d = request.resource.data;
        let soma = resource.data.get('notaSoma', 0);
        let total = resource.data.get('notaTotal', 0);
        return isLoggedIn()
          && resource.data.status == 'aprovado'
          && d.diff(resource.data).affectedKeys().hasOnly(['notaSoma', 'notaTotal'])
          && (
            (!exists(aval) && existsAfter(aval) && d.notaTotal == total + 1 && d.notaSoma == soma + getAfter(aval).data.nota)
            || (exists(aval) && existsAfter(aval) && d.get('notaTotal', 0) == total && d.get('notaSoma', 0) == soma - get(aval).data.nota + getAfter(aval).data.nota)
            || (exists(aval) && !existsAfter(aval) && d.notaTotal == total - 1 && d.notaSoma == soma - get(aval).data.nota)
          );
      }

      // O público só vê negócios aprovados; o dono e a equipa vêem sempre o seu.
      allow get: if resource.data.status == 'aprovado' || podeGerir(resource.data) || isAdmin();
      allow list: if resource.data.status == 'aprovado' || isAdmin()
        || (isLoggedIn() && resource.data.ownerUid == request.auth.uid)
        || (isLoggedIn() && request.auth.uid in resource.data.membros);

      // Nasce como rascunho, sem selo e no plano grátis.
      allow create: if isLoggedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'rascunho'
        && request.resource.data.verificado == false
        && request.resource.data.plano == 'gratis'
        && !request.resource.data.keys().hasAny(['equipa', 'membros', 'planoAte'])
        && negocioValido(request.resource.data);

      // Selo, plano e dono não se mudam daqui; a equipa só o dono muda. O dono só pode pedir aprovação;
      // aprovar ou rejeitar é só para a administração. Depois de aprovado, o nome fica preso:
      // o selo foi dado àquele nome.
      function promoPermitida() {
        let d = request.resource.data;
        return !d.diff(resource.data).affectedKeys().hasAny(['promo'])
          || !('promo' in d)
          || (resource.data.get('plano', 'gratis') == 'premium' && resource.data.planoAte > request.time
            && d.promo.keys().hasOnly(['texto', 'ate'])
            && d.promo.texto is string && d.promo.texto.size() >= 3 && d.promo.texto.size() <= 80
            && d.promo.ate is number && d.promo.ate <= request.time.toMillis() + 14460000);
      }

      allow update: if isAdmin() || contagemAvaliacao() || (
        podeGerir(resource.data)
        && negocioValido(request.resource.data)
        && promoPermitida()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'verificado', 'plano', 'planoAte', 'motivoRejeicao', 'notaSoma', 'notaTotal'])
        && (resource.data.ownerUid == request.auth.uid || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['equipa', 'membros']))
        && (podeEditar(resource.data) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sobras', 'lojaFechada', 'filaAberta']))
        && (resource.data.status != 'aprovado' || request.resource.data.nome == resource.data.nome)
        && (request.resource.data.status == resource.data.status
          || (resource.data.status in ['rascunho', 'rejeitado'] && request.resource.data.status == 'pendente'))
      );

      allow delete: if isAdmin() || (isLoggedIn() && resource.data.ownerUid == request.auth.uid);

      match /produtos/{produtoId} {
        allow read: if negocio().status == 'aprovado' || podeGerir(negocio()) || isAdmin();
        allow create: if podeEditar(negocio()) && produtoValido(request.resource.data);
        // A caixa só mexe no stock, ao aceitar ou cancelar um pedido.
        allow update: if produtoValido(request.resource.data) && (
          podeEditar(negocio())
          || (podeGerir(negocio()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']))
        );
        allow delete: if podeEditar(negocio());
      }

      match /pedidos/{pedidoId} {
        allow get, list: if isLoggedIn() && (resource.data.clienteUid == request.auth.uid || podeGerir(negocio()));
        allow create: if isLoggedIn() && pedidoValido(database, request.resource.data, negocio(), negocioId);
        allow update: if isLoggedIn() && (
          (podeGerir(negocio())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'pago', 'updatedAt'])
            && request.resource.data.pago is bool
            && transicaoPedido(resource.data.estado, request.resource.data.estado))
          || (resource.data.clienteUid == request.auth.uid
            && resource.data.estado == 'novo'
            && request.resource.data.estado == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updatedAt']))
        );
        // Só ao eliminar a conta do dono.
        allow delete: if isLoggedIn() && negocio().ownerUid == request.auth.uid;
      }

      // Avaliações: uma por cliente, só depois de um pedido entregue. A resposta é do negócio.
      match /avaliacoes/{clienteUid} {
        function avaliacaoValida(d) {
          return d.nota is int && d.nota >= 1 && d.nota <= 5
            && d.texto is string && d.texto.size() <= 500
            && urlImagem(d.fotoUrl);
        }
        allow get, list: if negocio().status == 'aprovado' || podeGerir(negocio()) || isAdmin();
        allow create: if isLoggedIn()
          && request.auth.uid == clienteUid
          && request.resource.data.clienteUid == clienteUid
          && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 100
          && request.resource.data.resposta == ''
          && avaliacaoValida(request.resource.data)
          && get(/databases/$(database)/documents/negocios/$(negocioId)/pedidos/$(request.resource.data.pedidoId)).data.clienteUid == clienteUid
          && get(/databases/$(database)/documents/negocios/$(negocioId)/pedidos/$(request.resource.data.pedidoId)).data.estado == 'entregue'
          && negocioDepois().get('notaTotal', 0) == negocio().get('notaTotal', 0) + 1;
        allow update: if isLoggedIn() && (
          (request.auth.uid == clienteUid
            && avaliacaoValida(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota', 'texto', 'fotoUrl', 'updatedAt'])
            && negocioDepois().get('notaSoma', 0) == negocio().get('notaSoma', 0) - resource.data.nota + request.resource.data.nota)
          || (podeGerir(negocio())
            && request.resource.data.resposta is string && request.resource.data.resposta.size() <= 500
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'respostaEm']))
        );
        // O dono só ao eliminar a conta; retirar uma avaliação denunciada é com a administração.
        allow delete: if isAdmin() || (isLoggedIn() && (
          (request.auth.uid == clienteUid && negocioDepois().get('notaTotal', 0) == negocio().get('notaTotal', 0) - 1)
          || negocio().ownerUid == request.auth.uid
        ));
      }

      // Índice de preços do comparador: um documento só, público como o catálogo.
      match /publico/{docId} {
        allow get: if negocio().status == 'aprovado' || podeGerir(negocio()) || isAdmin();
        allow create, update: if podeGerir(negocio()) && request.resource.data.itens is map;
        allow list, delete: if isLoggedIn() && negocio().ownerUid == request.auth.uid;
      }

      // Pró-formas do negócio: o dono e a equipa.
      match /proformas/{pfId} {
        allow read: if podeGerir(negocio()) || isAdmin();
        allow create: if podeGerir(negocio()) && proformaValida(request.resource.data);
        allow delete: if isLoggedIn() && negocio().ownerUid == request.auth.uid;
      }
      match /proformaSeq/{seqId} {
        allow read: if podeGerir(negocio());
        allow write: if podeGerir(negocio()) && seqId == 'atual' && contadorProforma();
      }

      // Números da loja: quem abre a Montra soma 1 a um contador do dia, um campo de cada vez.
      // Ninguém consegue baixar nem saltar números; só o dono, a equipa e a administração lêem.
      match /estatisticas/{dia} {
        function nasceComUm(k) {
          return request.resource.data.keys().hasOnly([k]) && request.resource.data[k] == 1;
        }
        function somaUm(k) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([k])
            && request.resource.data[k] == resource.data.get(k, 0) + 1;
        }
        allow read: if podeGerir(negocio()) || isAdmin();
        allow create: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (nasceComUm('visitas') || nasceComUm('ligacoes') || nasceComUm('whatsapp') || nasceComUm('pedidos'));
        allow update: if somaUm('visitas') || somaUm('ligacoes') || somaUm('whatsapp') || somaUm('pedidos');
      }

      // Painel de senhas: público e sem nomes. O número sobe um de cada vez, e a loja só mexe em quem está a chamar.
      match /contadores/{nome} {
        function filaAberta() {
          return isLoggedIn() && nome == 'fila' && negocio().status == 'aprovado' && negocio().get('filaAberta', false) == true;
        }
        allow get: if negocio().status == 'aprovado' || podeGerir(negocio()) || isAdmin();
        allow create: if filaAberta()
          && request.resource.data.dia is string
          && request.resource.data.ultimo == 1
          && request.resource.data.chamado == 0;
        allow update: if (filaAberta() && (
            (request.resource.data.dia == resource.data.dia
              && request.resource.data.ultimo == resource.data.ultimo + 1
              && request.resource.data.chamado == resource.data.chamado)
            || (request.resource.data.dia != resource.data.dia
              && request.resource.data.ultimo == 1
              && request.resource.data.chamado == 0)
          ))
          || (podeGerir(negocio())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chamado'])
            && request.resource.data.chamado is int
            && request.resource.data.chamado <= resource.data.ultimo);
        allow list, delete: if isLoggedIn() && negocio().ownerUid == request.auth.uid;
      }

      // Senhas: uma por cliente em cada loja. O número tem de ser o que o contador acabou de dar.
      match /fila/{clienteUid} {
        function senhaValida() {
          let d = request.resource.data;
          let contador = getAfter(/databases/$(database)/documents/negocios/$(negocioId)/contadores/fila).data;
          return request.auth.uid == clienteUid
            && negocio().status == 'aprovado'
            && negocio().get('filaAberta', false) == true
            && d.clienteUid == clienteUid
            && d.estado == 'espera'
            && d.numero == contador.ultimo
            && d.dia == contador.dia
            && d.clienteNome is string && d.clienteNome.size() <= 100
            && d.clienteTelefone is string && d.clienteTelefone.size() <= 20
            && d.pessoas is int && d.pessoas >= 1 && d.pessoas <= 50;
        }
        allow get: if isLoggedIn() && (request.auth.uid == clienteUid || podeGerir(negocio()));
        allow list: if podeGerir(negocio());
        allow create: if isLoggedIn() && senhaValida();
        allow update: if isLoggedIn() && (
          (senhaValida() && (resource.data.dia != request.resource.data.dia || resource.data.estado in ['saiu', 'atendido', 'faltou']))
          || (request.auth.uid == clienteUid
            && resource.data.estado in ['espera', 'chamado']
            && request.resource.data.estado == 'saiu'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updatedAt']))
          || (podeGerir(negocio())
            && request.resource.data.estado in ['chamado', 'atendido', 'faltou']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updatedAt']))
        );
        allow delete: if isLoggedIn() && (request.auth.uid == clienteUid || negocio().ownerUid == request.auth.uid);
      }

      // Reservas de mesa: o cliente pede, o negócio responde.
      match /reservas/{reservaId} {
        allow get, list: if isLoggedIn() && (resource.data.clienteUid == request.auth.uid || podeGerir(negocio()));
        allow create: if isLoggedIn()
          && request.resource.data.clienteUid == request.auth.uid
          && request.resource.data.negocioId == negocioId
          && negocio().status == 'aprovado'
          && negocio().get('mesas', false) == true
          && request.resource.data.estado == 'pendente'
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.hora.matches('^[0-9]{2}:[0-9]{2}$')
          && request.resource.data.pessoas is int && request.resource.data.pessoas >= 1 && request.resource.data.pessoas <= 50
          && request.resource.data.clienteNome is string && request.resource.data.clienteNome.size() <= 100
          && request.resource.data.clienteTelefone is string && request.resource.data.clienteTelefone.size() <= 20
          && request.resource.data.nota is string && request.resource.data.nota.size() <= 200;
        allow update: if isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updatedAt']) && (
          (podeGerir(negocio()) && request.resource.data.estado in ['confirmada', 'recusada', 'concluida', 'faltou'])
          || (resource.data.clienteUid == request.auth.uid
            && resource.data.estado in ['pendente', 'confirmada']
            && request.resource.data.estado == 'cancelada')
        );
        allow delete: if isLoggedIn() && negocio().ownerUid == request.auth.uid;
      }

      // Carimbos de fidelidade: é o negócio que os dá, ao entregar. O cliente só lê os seus.
      match /cartoes/{clienteUid} {
        allow get: if isLoggedIn() && (request.auth.uid == clienteUid || podeGerir(negocio()));
        allow create, update: if podeGerir(negocio())
          && request.auth.uid != clienteUid
          && request.resource.data.carimbos is int && request.resource.data.carimbos >= 0;
        allow delete: if isLoggedIn() && (request.auth.uid == clienteUid || negocio().ownerUid == request.auth.uid);
        allow list: if isLoggedIn() && negocio().ownerUid == request.auth.uid;
      }
    }

    // Verificação (NIF, alvará, fachada): privada. Só o dono e a administração lêem.
    match /verificacoes/{negocioId} {
      allow read: if isAdmin() || (isLoggedIn() && resource.data.ownerUid == request.auth.uid);
      // Para os dados saírem com a conta, ao eliminar conta.
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update: if isAdmin() || (
        isLoggedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/negocios/$(negocioId)).data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && nifValido(request.resource.data.nif)
        && request.resource.data.alvara is string && request.resource.data.alvara.size() > 0
        && request.resource.data.fachada is string && request.resource.data.fachada.size() > 0
      );
    }

  }
}
